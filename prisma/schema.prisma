// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// User = Moniteur qui peut se connecter
model User {
  id        String   @id @default(cuid())
  username  String   @unique // Nom d'utilisateur unique
  password  String   // Mot de passe hashé
  name      String?
  role      String   @default("MONITOR") // "MONITOR" or "ADMIN"
  title     String?  // Ex: "Directeur de l'écodim", "Second"
  isBlocked Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Suivi des agissements des moniteurs (Activity Logs)
model ActivityLog {
  id           String   @id @default(cuid())
  userId       String
  username     String   // Nom d'utilisateur de l'auteur de l'action
  userFullName String?  // Nom complet de l'auteur
  action       String   // "CONNEXION", "CREATE_USER", "BLOCK_USER", "UNBLOCK_USER", "DELETE_USER", "UPLOAD_FILE", "SYNC_DATA"
  details      String
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

// Enfant
model Child {
  id          String   @id @default(cuid())
  firstName   String
  lastName    String
  postName    String   @default("")
  classLevel  String   @default("FIRST")
  parentPhone String
  address     String
  birthDate   String?
  notes       String?
  photoUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  attendances Attendance[]

  @@index([updatedAt])
}

// Présences (Pointage)
model Attendance {
  id        String   @id @default(cuid())
  childId   String
  date      String   // Format YYYY-MM-DD
  present   Boolean  @default(false)
  status    String   @default("ABSENT")
  markedAt  DateTime @default(now())

  child     Child    @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@unique([childId, date]) // Un enfant ne peut avoir qu'un seul pointage par jour
  @@index([markedAt])
}

// Ressources Multimédias (Images, Vidéos, PDFs) stockées en ligne
model MediaResource {
  id          String   @id @default(cuid())
  type        String   // "image", "video", "pdf"
  title       String
  url         String
  thumbnail   String?  // Couleur bg (ex: "bg-rose-300") ou URL d'image
  aspectRatio String   @default("square") // "tall", "wide", "square"
  createdAt   DateTime @default(now())
  
  @@index([type])
  @@index([createdAt])
}
